<div role="group">
  <%= link_to "yesterday", entries_path(date: (Time.zone.today - 1.day), mode: @mode), method: :get, role: "button", class: "slim" %>
  <%= link_to "today", entries_path(date: Time.zone.today, mode: @mode), method: :get, role: "button", class: "slim" %>
  <%= link_to "tomorrow", entries_path(date: (Time.zone.today + 1.day), mode: @mode), method: :get, role: "button", class: "slim" %>

  <%- # TODO: add datepicker to select any day %>
  <%- # <input type="date" id="datepicker" name="any-date" value= <%= Time.zone.today.iso8601 % > class="slimmer" /> %>
</div>
