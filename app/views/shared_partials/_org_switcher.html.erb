<details class="dropdown with-shadow">
  <% current_org_project = [current_org&.name, current_project&.name].compact.join(' | ') %>
  <summary role="button" class="slim-summary"> <!-- TODO: ensure overflow: hidden works -->
    <span class="slim-summary-caption">
      <%= current_org_project.presence || "Select an org | project" %>
      </span>
  </summary>

  <ul>
    <% current_user.memberships.active.includes(:org, participations: :project).order("org.name asc").each do |member| %>
      <li class="without-bullet">
        <b>
          <%= link_to member.org.name, org_path(member.org), method: :get, class: "links slim camouflage" %>
        </b>
      </li>

      <% member.participations.includes(:project).where(project: { archived_at: nil }).order("project.name asc").each do |participation| %>
        <li class="without-bullet">
          <%= link_to "#{member.org.name} | #{participation.project.name}", project_path(member.org, participation.project), method: :get, class: "links slim camouflage" %>
        </li>
      <% end %>
    <% end %>
  </ul>
</details>
