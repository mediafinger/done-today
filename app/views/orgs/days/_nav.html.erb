<%# locals: (date:, project:, editing: false, unlockable: false, unlocked: false, validatable: false) %>

<%# another project than the current one stays in the links %>
<% project_id = project.id unless project == current_project %>
<% writable = policy(project).create_entry? %>

<div class="spacing-grid" style="margin-bottom: 0.5rem;">

  <div class="left">
    <h2><%= project.name %> Day <%= date.iso8601 %> (<%= date.strftime("%A") %>)</h2>
  </div>

  <div class="center">
    <% if project != current_project && writable %>
      <%= link_to "Switch to project '#{project.name}' to add or edit", open_path(project.org.slug, project.slug), method: :get, role: "button", class: "slim" %>
    <% elsif !editing && writable %>
      <%= link_to "add or edit", edit_day_path(date), method: :get, role: "button", class: "slim" %>
    <% end %>

    <% if editing %>
      <%= link_to "view all", day_path(date, project_id:), method: :get, role: "button", class: "slim" %>

      <%# checks this member's own times of the day -- see DaysController#validate_day %>
      <% if validatable %>
        <%= link_to "validate", edit_day_path(date, unlocked: (unlocked || nil), validate: "1"),
              method: :get, role: "button", class: "slim" %>
      <% end %>

      <%# A past day is read-only until it is unlocked on purpose -- the toggle covers
          the whole day, and leaving the page drops it again. %>
      <% if unlockable %>
        <% if unlocked %>
          <%= link_to "🔓 lock again", edit_day_path(date), method: :get, role: "button", class: "slim" %>
        <% else %>
          <%= link_to "🔒 unlock to edit", edit_day_path(date, unlocked: "1"), method: :get, role: "button", class: "slim" %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <div class="right">
    <% path = editing ? :edit_day_path : :day_path %>
    <%= link_to "⬅️", public_send(path, date - 1.day, project_id:), method: :get, role: "button", class: "slim" %>
    <%= link_to "➡️", public_send(path, date + 1.day, project_id:), method: :get, role: "button", class: "slim" %>
  </div>

</div>
