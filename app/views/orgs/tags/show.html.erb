<div class="spacing-grid" style="margin-bottom: 0.5rem;">

  <div class="left">
    <h2> <%= @project.name %> #<%= @tag %> </h2>
  </div>

  <div class="center"></div>

  <div class="right">
    <%= link_to "project", project_path(current_org, @project), method: :get, role: "button", class: "slim" %>
  </div>

</div>

<ul id="entries">
  <% @entries.each_with_index do |entry, index| %>
    <%= render "orgs/entries/entry", entry: entry, entries: @entries, index: index, with_date: true, with_member: true %>
  <% end %>
</ul>

<% if @entries.none? %>
  <p>No entries are tagged #<%= @tag %> yet.</p>
<% end %>
