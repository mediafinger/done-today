<div class="spacing-grid" style="margin-bottom: 0.5rem;">

  <div class="left">
    <h2> <%= @project ? @project.name : current_org.name %> tag times <%= @period.label %><%= ", #{@member.name}" if @member %> </h2>
  </div>

  <div class="center">
    <% if @project %>
      <%= link_to "project", project_path(current_org, @project), method: :get, role: "button", class: "slim" %>
    <% end %>
    <% if @member %>
      <%= link_to "everyone", tag_times_path(@project, @period), id: "everyone", method: :get, role: "button", class: "slim" %>
    <% end %>
    <% if @project %>
      <%= link_to "Export CSV", tag_times_path(@project, @period, member: @member, format: :csv), id: "export-csv", method: :get, role: "button", class: "slim" %>
    <% end %>
  </div>

  <div class="right">
    <%= link_to "⬅️", tag_times_path(@project, @period.previous, member: @member), method: :get, role: "button", class: "slim" %>
    <%= link_to "➡️", tag_times_path(@project, @period.following, member: @member), method: :get, role: "button", class: "slim" %>
  </div>

</div>

<div id="period-kinds" class="project-views">
  <% ReportPeriod::KINDS.each do |kind| %>
    <% current = kind == @period.kind %>
    <%= link_to kind, tag_times_path(@project, @period.as(kind, today: Time.zone.today), member: @member), method: :get, role: "button",
          class: "slim #{'btn-inactive' unless current}", aria: { current: ("page" if current) } %>
  <% end %>
</div>

<% if @tag_times.rows.any? %>
  <div class="overflow-auto">
    <table id="tag-times">
      <thead>
        <tr>
          <th scope="col">Tag</th>
          <% unless @member %>
            <th scope="col">Who</th>
          <% end %>
          <th scope="col">Time</th>
        </tr>
      </thead>
      <% @tag_times.rows.each do |row| %>
        <tbody>
          <% if @member %>
            <tr>
              <th scope="row"><%= tag_times_tag(row.tag, @project) %></th>
              <td><%= format_minutes(row.minutes) %></td>
            </tr>
          <% else %>
            <tr>
              <th scope="rowgroup" rowspan="<%= row.members.size + 1 %>"><%= tag_times_tag(row.tag, @project) %></th>
              <td>Total</td>
              <td><strong><%= format_minutes(row.minutes) %></strong></td>
            </tr>
            <% row.members.each do |member, minutes| %>
              <tr>
                <td><%= link_to member.name, tag_times_path(@project, @period, member:) %></td>
                <td><%= format_minutes(minutes) %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>
<% else %>
  <p>No tag times in <%= @period.label %>. A duration counts for the one #tag on its line, like <code>#call for~40m</code>.</p>
<% end %>
