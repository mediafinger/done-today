<div class="spacing-grid" style="margin-bottom: 0.5rem;">

  <div class="left">
    <h2> <%= @project.name %> tag times <%= @period.label %> </h2>
  </div>

  <div class="center">
    <%= link_to "project", project_path(current_org, @project), method: :get, role: "button", class: "slim" %>
  </div>

  <div class="right">
    <%= link_to "⬅️", tags_path(current_org, @project, **@period.previous.param), method: :get, role: "button", class: "slim" %>
    <%= link_to "➡️", tags_path(current_org, @project, **@period.following.param), method: :get, role: "button", class: "slim" %>
  </div>

</div>

<div id="period-kinds" class="project-views">
  <% ReportPeriod::KINDS.each do |kind| %>
    <% current = kind == @period.kind %>
    <%= link_to kind, tags_path(current_org, @project, **@period.as(kind, today: Time.zone.today).param), method: :get, role: "button",
          class: "slim #{'btn-inactive' unless current}", aria: { current: ("page" if current) } %>
  <% end %>
</div>

<% if @tag_times.rows.any? %>
  <div class="overflow-auto">
    <table id="tag-times">
      <thead>
        <tr>
          <th scope="col">Tag</th>
          <th scope="col">Who</th>
          <th scope="col">Time</th>
        </tr>
      </thead>
      <% @tag_times.rows.each do |row| %>
        <tbody>
          <tr>
            <th scope="rowgroup" rowspan="<%= row.members.size + 1 %>"><%= link_to "##{row.tag}", tag_path(current_org, @project, row.tag) %></th>
            <td>Total</td>
            <td><strong><%= format_minutes(row.minutes) %></strong></td>
          </tr>
          <% row.members.each do |member, minutes| %>
            <tr>
              <td><%= member.name %></td>
              <td><%= format_minutes(minutes) %></td>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>
<% else %>
  <p>No tag times in <%= @period.label %>. A duration counts for the one #tag on its line, like <code>#call for~40m</code>.</p>
<% end %>
