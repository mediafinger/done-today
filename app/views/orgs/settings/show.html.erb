<%# /settings, and /:org_slug/settings, which adds the org's part %>

<%= button_to "Logout", session_path, method: :delete, role: "button", class: "slim" %>

<h2>Settings</h2>

<ul>
  <li> User name: <b><%= current_user.name %></b></li>
  <% if current_org %>
    <li>
      Org: <b><%= current_org.name %></b>
      <% if allowed_to?(:index?, Member) %>
        (<%= link_to allowed_to?(:manage?, Member) ? "manage members" : "members", members_path(current_org) %>)
      <% end %>
    </li>
    <li>Participant of projects: <b><%= current_member.projects.pluck(:name).join(", ") %></b></li>
  <% end %>
</ul>

<% if current_org %>
  <h2>Projects of '<%= current_org.name %>'</h2>

  <ul>
    <% @projects.each do |project| %>
      <li><%= link_to project.name, project_path(current_org, project), method: :get %></li>
    <% end %>
  </ul>
<% else %>
  <h2>Orgs</h2>

  <ul>
    <% @orgs.each do |org| %>
      <li><%= link_to org.name, org_settings_path(org), method: :get %></li>
    <% end %>
  </ul>
<% end %>

<% if allowed_to?(:access?, :admin) %>
  <section>
    <h2>Admin</h2>

    <ul>
      <li><%= link_to "Admin area", admin_home_path %></li>
      <li><%= link_to "Jobs (Mission Control)", admin_mission_control_jobs_path %></li>
    </ul>
  </section>
<% end %>

<% if dev_area? %>
  <section>
    <h2>Development</h2>

    <ul>
      <li><%= link_to "Dev area", dev_home_path %></li>
      <% if defined?(LetterOpenerWeb) %>
        <li><%= link_to "Sent mail (letter_opener_web)", "/dev/letter_opener" %></li>
      <% end %>
    </ul>
  </section>
<% end %>
