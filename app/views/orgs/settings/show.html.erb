<%# /settings, and /:org_slug/settings, which adds the org's part %>

<%= button_to "Logout", session_path, method: :delete, role: "button", class: "slim" %>

<h2>Settings</h2>

<ul>
  <li> User name: <b><%= current_user.name %></b></li>
  <% if current_org %>
    <li>
      Org: <b><%= current_org.name %></b>
      <% if policy(Member).index? %>
        (<%= link_to "manage members", members_path(current_org) %>)
      <% end %>
    </li>
    <li>Participant of projects: <b><%= current_member.projects.pluck(:name).join(", ") %></b></li>
  <% end %>
</ul>

<% if current_org %>
  <h2>Projects of '<%= current_org.name %>'</h2>

  <ul>
    <% @projects.each do |project| %>
      <li><%= link_to project.name, project_path(current_org, project), method: :get %></li>
    <% end %>
  </ul>
<% else %>
  <h2>Orgs</h2>

  <ul>
    <% @orgs.each do |org| %>
      <li><%= link_to org.name, org_settings_path(org), method: :get %></li>
    <% end %>
  </ul>
<% end %>
