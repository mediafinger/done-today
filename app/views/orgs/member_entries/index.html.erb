<% index = @members.index(@member.id) %>

<div class="spacing-grid" style="margin-bottom: 0.5rem;">

  <div class="left">
    <h2> <%= @project.name %> <%= @member.name %> </h2>
  </div>

  <div class="center">
    <% if allowed_to?(:create_entry?, @project) %>
      <%= link_to "add or edit", edit_day_path(current_org, @project, Time.zone.today), method: :get, role: "button", class: "slim" %>
    <% end %>
  </div>

  <div class="right">
    <%= link_to "⬅️", member_entries_path(current_org, @project, @members[index - 1]), method: :get, role: "button", class: "slim" %>
    <%= link_to "➡️", member_entries_path(current_org, @project, @members[(index + 1) % @members.size]), method: :get, role: "button", class: "slim" %>
  </div>

</div>

<ul id="entries">
  <% @entries.each_with_index do |entry, index| %>
    <%= render "orgs/entries/entry", entry: entry, entries: @entries, index: index, with_date: true %>
  <% end %>
</ul>

<% if @entries.none? %>
  <p><%= @member.name %> has not logged anything yet.</p>
<% end %>
