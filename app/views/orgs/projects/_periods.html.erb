<%# locals: (periods:, view:, project:, exportable: false) %>

<%# One block per week or month: the heading on its own line, then one line per
    member who added entries in it -- their total time and their tags, no logs,
    no statuses. %>

<% periods.each do |period| %>
  <div class="period">
    <h3 class="entry-group-heading">
      <%= period_heading(period, view:, project:) %>

      <%# a full month of everybody's entries -- for an owner of the org or the project %>
      <% if exportable && view == "months" %>
        <%= link_to "Export Month", export_csv_project_path(project.slug, month: period.start.strftime("%Y-%m")),
              method: :get, role: "button", class: "slim" %>
      <% end %>
    </h3>

    <ul>
      <% period.rows.each do |row| %>
        <li class="nude left-spacer">
          <%= link_to row.member.name, entries_path(member_id: row.member.id, project_id: project.id), method: :get, class: "camouflage" %>
          <% if row.total_minutes %>
            (<%= format_minutes(row.total_minutes) %>)
          <% end %>

          <%# the member's single days of the month %>
          <% if exportable && view == "months" %>
            <%= link_to "Export days",
                  export_days_csv_project_path(project.slug, month: period.start.strftime("%Y-%m"), member_id: row.member.id),
                  method: :get, role: "button", class: "slim" %>
          <% end -%>

          <% row.tags.each do |tag| %>
            <%= tag_link(tag, project:) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
