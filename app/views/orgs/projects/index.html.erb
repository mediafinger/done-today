<div class="spacing-grid">
  <div class="left">
    <h2> Projects of <%= current_org.name %> </h2>

    <ul id="active-projects">
      <% @projects.each do |project| %>
        <li class="nude" id="<%= dom_id(project) %>">
          <% if @readable_ids.include?(project.id) %>
            <%= link_to project.name, project_path(current_org, project), method: :get, role: "button", class: "slim" %>
          <% else %>
            <%= project.name %> <small>(<%= join_project_hint(project) %>)</small>
            <% if (participation_request = @participation_requests[project.id]) %>
              <small>asked to join on <%= participation_request.created_at.to_date %></small>
            <% elsif allowed_to?(:request_access?, project) %>
              <details>
                <summary>Ask to join</summary>
                <%= form_with model: ParticipationRequest.new, url: participation_requests_path(current_org, project), namespace: dom_id(project) do |form| %>
                  <fieldset role="group">
                    <%= form.text_field :message, maxlength: 500, placeholder: "Message to the project leads (optional)", aria: { label: "Message" } %>
                    <%= form.submit "Ask to join", class: "slim" %>
                  </fieldset>
                <% end %>
              </details>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if @projects.none? %>
      <p>
        <%= current_org.name %> has no projects yet.
        <% unless allowed_to?(:create?, Project) %>Ask an owner of <%= current_org.name %> to add one.<% end %>
      </p>
    <% end %>

    <% if allowed_to?(:create?, Project) %>
      <%= link_to "New project", new_project_path(current_org), method: :get, role: "button", class: "slim secondary" %>
    <% end %>

    <% if @archived_projects.any? %>
      <h3>Archived</h3>

      <ul id="archived-projects">
        <% @archived_projects.each do |project| %>
          <li class="nude"><%= link_to project.name, project_path(current_org, project), method: :get %> (<%= project.archived_at.to_date %>)</li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
