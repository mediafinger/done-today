<h2>Manage <%= link_to @project.name_in_database, project_path(current_org, @project) %></h2>

<section>
  <h3>Name</h3>

  <p>The link to the project keeps its address <code><%= project_path(current_org, @project) %></code>.</p>

  <%= render "orgs/projects/form", project: @project %>
</section>

<section>
  <h3>Archive</h3>

  <% if @project.archived? %>
    <p>Archived on <%= @project.archived_at.to_date %>. Its entries can be read and exported, but not changed.</p>

    <%= button_to "Unarchive", unarchive_project_path(current_org, @project), method: :patch, class: "slim" %>
  <% else %>
    <p>An archived project keeps its entries for reading and exporting, but takes no new ones. It can be unarchived.</p>

    <%= button_to "Archive", archive_project_path(current_org, @project), method: :patch, class: "slim secondary",
          form: { data: { turbo_confirm: "Archive #{@project.name_in_database}? Its entries stay readable." } } %>
  <% end %>
</section>

<section>
  <h3>Participants</h3>

  <p>Observers read the project, participants also log their time, leads also edit everybody's entries and manage the project. Removing someone keeps their entries.</p>

  <table id="participants">
    <thead>
      <tr>
        <th>Name</th>
        <th>Role</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @participants.each do |participant| %>
        <tr id="<%= dom_id(participant) %>">
          <td><%= participant.member.name %><%= " (guest)" if participant.member.guest? %><%= " (deactivated)" if participant.member.archived? %><%= " (you)" if participant.member_id == current_member.id %></td>
          <td>
            <%= form_with model: participant, url: participant_path(current_org, @project, participant), method: :patch, namespace: dom_id(participant) do |form| %>
              <fieldset role="group">
                <%= form.select :role, participant_roles_for(participant.member), { selected: participant.role }, aria: { label: "Role" } %>
                <%= form.submit "Save role", class: "slim" %>
              </fieldset>
            <% end %>
          </td>
          <td>
            <%= button_to "Remove", participant_path(current_org, @project, participant), method: :delete, class: "slim secondary",
                  form: { data: { turbo_confirm: "Remove #{participant.member.name} from #{@project.name_in_database}? Their entries stay." } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @candidates.any? %>
    <%= form_with model: Participant.new, url: participants_path(current_org, @project), id: "new-participant" do |form| %>
      <fieldset role="group">
        <%= form.select :member_id, grouped_options_for_select(participant_candidates(@candidates)), {}, aria: { label: "Member" } %>
        <%= form.select :role, Participant::VALID_ROLES, { selected: "participant" }, aria: { label: "Role" } %>
        <%= form.submit "Add", class: "slim" %>
      </fieldset>
    <% end %>
  <% end %>
</section>

<% if allowed_to?(:invite_guest?, @project) %>
  <section>
    <h3>Invite a guest</h3>

    <p>Guests are externals: they only see the projects they participate in, and never own one.</p>

    <%= form_with model: Invitation.new, url: guest_invitations_path(current_org, @project), id: "new-guest-invitation" do |form| %>
      <fieldset role="group">
        <%= form.email_field :email, required: true, placeholder: "Email address", aria: { label: "Email address" } %>
        <%= form.text_field :name, placeholder: "Name (optional)", aria: { label: "Name" } %>
        <%= form.select :project_role, Participant::GUEST_ROLES.reverse, { selected: "participant" }, aria: { label: "Role" } %>
        <%= form.submit "Invite", class: "slim" %>
      </fieldset>
    <% end %>

    <% if @guest_invitations.any? %>
      <table id="guest-invitations">
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Sent on</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @guest_invitations.each do |invitation| %>
            <tr id="<%= dom_id(invitation) %>">
              <td><%= invitation.email %></td>
              <td><%= invitation.project_role %></td>
              <td><%= invitation.sent_at.to_date %><%= ", expired" if invitation.expired? %></td>
              <td>
                <% if allowed_to?(:manage?, invitation) %>
                  <%= button_to "Resend", resend_guest_invitation_path(current_org, @project, invitation), method: :patch, class: "slim" %>
                  <%= button_to "Revoke", guest_invitation_path(current_org, @project, invitation), method: :delete, class: "slim secondary",
                        form: { data: { turbo_confirm: "Revoke the invitation of #{invitation.email}?" } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
<% end %>
