<h2><%= @project.name %></h2>

<div class="project-views">
  <% Orgs::ProjectsController::VIEWS.each do |view| %>
    <%= link_to view, project_path(@project.slug, view: (view unless view == "days")), method: :get, role: "button",
          class: "slim #{'btn-inactive' unless view == @view}", aria: { current: ("page" if view == @view) } %>
  <% end %>

  <%= link_to "validate times", validate_times_project_path(@project.slug), method: :get, role: "button", class: "slim" %>
</div>

<ul class="bottom-spacer">
  <li class="nude">The participants</li>
  <% @project.participants.each do |participant| %>
    <li class="nude"><%= link_to participant.member.name, member_entries_path(participant.member_id, project_id: participant.project_id), method: :get %></li>
  <% end %>
  <li class="nude">Have added <%= @entries_count %> entries since <%= @project.created_at.to_date %></li>
</ul>

<% if @view == "days" %>
  <% @days.each do |day| %>
    <% totals = TimeSummary.day_totals(day.entries) %>

    <ul>
      <% day.entries.each_with_index do |entry, index| %>
        <li class="nude">
          <%= render "orgs/entries/entry", entry: entry, entries: day.entries, index: index, with_date: @with_date, with_weekday: true, with_project: @with_project, with_member: @with_member, totals: %>
        </li>
      <% end %>
    </ul>

    <%# the days run newest first, so a Monday closes its week %>
    <% if day.date.monday? %>
      <hr>
    <% end %>
  <% end %>
<% else %>
  <%= render "orgs/projects/periods", periods: @periods, view: @view, project: @project, exportable: @exportable %>
<% end %>
