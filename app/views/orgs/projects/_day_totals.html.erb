<%# locals: (day:) %>

<%# Just the total working time of each member on the day -- the day page has the
    details. A member without both start@ and end@ has no total, so no line. %>

<% totals = TimeSummary.by_member(day.entries).select { |_member, summary| summary.total_minutes } %>

<% if totals.any? %>
  <div class="time-summary">
    <% totals.each do |member, summary| %>
      <p class="time-info <%= "time-#{summary.status}" if summary.status %>">
        <%= day.date.iso8601 %> <strong><%= member.name %></strong> <%= format_minutes(summary.total_minutes) %> total
      </p>
    <% end %>
  </div>
<% end %>
