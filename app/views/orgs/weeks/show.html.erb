<div class="spacing-grid" style="margin-bottom: 0.5rem;">

  <div class="left">
    <h2> <%= @project.name %> <%= week_label(@week) %> </h2>
  </div>

  <div class="center">
    <%= link_to "weeks", project_path(current_org, @project, view: "weeks"), method: :get, role: "button", class: "slim" %>
  </div>

  <div class="right">
    <%= link_to "⬅️", week_path(current_org, @project, week_param(@week - 1.week)), method: :get, role: "button", class: "slim" %>
    <%= link_to "➡️", week_path(current_org, @project, week_param(@week + 1.week)), method: :get, role: "button", class: "slim" %>
  </div>

</div>

<ul id="entries">
  <% @entries.each_with_index do |entry, index| %>
    <%= render "orgs/entries/entry", entry: entry, entries: @entries, index: index, with_date: true, with_member: true, totals: @totals %>
  <% end %>
</ul>
