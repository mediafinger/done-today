<%# locals: (tag:, project:) %>

<%# Read-only on purpose: the entries of a tag span many days, and a day is
    only ever edited on its own page. %>

<div class="spacing-grid" style="margin-bottom: 0.5rem;">

  <div class="left">
    <h2> <%= project.name %> #<%= tag %> </h2>
  </div>

  <div class="center"></div>

  <div class="right">
    <%= link_to "project", project_path(project.slug), method: :get, role: "button", class: "slim" %>
  </div>

</div>
