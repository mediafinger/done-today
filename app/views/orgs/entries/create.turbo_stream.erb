<%# A new entry goes in above the input field, and the input field starts over blank. %>

<% if @entry.persisted? %>
  <%= turbo_stream.before "new-entry", partial: "orgs/entries/editable_entry", locals: { entry: @entry } %>
<% end %>

<%= turbo_stream.replace "new-entry", partial: "orgs/entries/new_entry", locals: { entry: @new_entry } %>
