<% if @group_by == "date" %>
  <%= render "orgs/entries/entries_nav_by_date", date: @date, mode: @mode, unlockable: @unlockable, unlocked: @unlocked, validatable: @validatable %>
<% else %>
  group_by '<%= @group_by %>' is invalid
<% end %>


<% if @mode == "edit" %>
  <%= render "orgs/entries/validation", issues: @issues, total_minutes: @validated_minutes, asked: @asked_to_validate if @issues %>

  <ul class="bottom-spacer" id="editable-entries">
    <% if @locked %>
      <% @entries.each_with_index do |entry, index| %>
        <%= render "orgs/entries/entry", entry: entry, entries: @entries, index: index %>
      <% end %>
    <% else %>
      <% @entries.each do |entry| %>
        <%= render "orgs/entries/editable_entry", entry: entry, unlocked: @unlocked %>
      <% end %>

      <%= render "orgs/entries/new_entry", entry: @new_entry, unlocked: @unlocked %>
    <% end %>
  </ul>

<% elsif @mode == "read" %>
  <%= render "orgs/entries/time_summary", entries: @entries, project: @project if @with_time_summary %>

  <ul id="entries">
    <% @entries.each_with_index do |entry, index| %>
      <%= render "orgs/entries/entry", entry: entry, entries: @entries, index: index, with_date: @with_date, with_member: true, with_project: @with_project %>
    <% end %>
  </ul>

<% else %>
  mode '<%= @mode %>' is invalid

<% end %>
