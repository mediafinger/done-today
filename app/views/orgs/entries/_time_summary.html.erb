<%# locals: (entries:, project:, with_tags: true) %>

<%# One time line per member, since everyone in the project shares the day, then
    all tags of the day in a single line. Renders nothing for a day without markup. %>

<%
  summaries = TimeSummary.by_member(entries).select { |_member, summary| summary.times? }
  tags = with_tags ? TimeSummary.new(entries).tags : []
%>

<% if summaries.any? || tags.any? %>
  <div class="time-summary">
    <% summaries.each do |member, summary| %>
      <p class="time-info <%= "time-#{summary.status}" if summary.status %>">
        <strong><%= member.name %></strong>
        <%= format_clock(summary.start_minutes) %> – <%= format_clock(summary.end_minutes) %>
        <% if summary.break_minutes.positive? %>
          · <%= format_minutes(summary.break_minutes) %> break
        <% end %>
        <% if summary.total_minutes %>
          · <strong><%= format_minutes(summary.total_minutes) %></strong> total
        <% end %>
      </p>
    <% end %>

    <% if tags.any? %>
      <p class="tag-info">
        <% tags.each do |tag| %>
          <%= tag_link(tag, project:) %>
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>
