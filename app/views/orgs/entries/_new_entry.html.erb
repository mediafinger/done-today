<%# locals: (entry:, unlocked: false) %>

<li class="nude" id="new-entry" data-controller="entry-form">
  <%= form_with(model: entry, url: entries_path(entry.org, entry.day.project), method: :post, data: {
        entry_form_target: "form",
        action: "keydown.esc->entry-form#revert keydown.enter->entry-form#askIfEmptied " \
                "submit->entry-form#markSubmitting turbo:submit-end->entry-form#submitEnded",
      }) do |form| %>

    <%= hidden_field_tag :unlocked, "1" if unlocked %>

    <% if entry.errors.any? %>
      <small class="error"><%= entry.errors.full_messages.to_sentence %></small>
    <% end %>

    <div role="group">
      <%# `autofocus` alone only fires on a full page load -- the autofocus controller
          also catches the Turbo Stream that re-renders this form after a create. %>
      <%= form.text_field :log, required: true, autofocus: true, value: entry.log,
            placeholder: "What have you done today?", minlength: 3, maxlength: 500,
            id: dom_id(entry, :log),
            data: { controller: "autofocus", entry_form_target: "log",
                    action: "input->entry-form#remember focus->entry-form#clearStatusPress blur->entry-form#saveIfChanged" } %>
      <%= form.hidden_field :date, value: entry.day.date %>
    </div>
  <% end %>

  <%= render "orgs/entries/emptied_dialog", entry:, unlocked: %>
</li>
