<h2>Members of <%= current_org.name %></h2>

<% if @can_manage %>
  <%= render "invitations" %>
<% end %>

<h3>Members</h3>

<table id="active-members">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Role</th>
      <% if @can_manage %><th></th><% end %>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "member", collection: @active_members %>
  </tbody>
</table>

<% if @guests.any? %>
  <h3>Guests (external)</h3>
  <p>Guests only see the projects they participate in.</p>

  <table id="guests">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Projects</th>
        <% if @can_manage %><th></th><% end %>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "member", collection: @guests, locals: { with_projects: true } %>
    </tbody>
  </table>
<% end %>

<% if @can_manage && @archived_members.any? %>
  <h3>Deactivated</h3>

  <table id="archived-members">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Deactivated on</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @archived_members.each do |member| %>
        <tr id="<%= dom_id(member) %>">
          <td><%= member.name %></td>
          <td><%= member.user.email %></td>
          <td><%= member.archived_at.to_date %></td>
          <td>
            <% if allowed_to?(:manage?, member) %>
              <%= button_to "Reactivate", reactivate_member_path(current_org, member), method: :patch, class: "slim" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
