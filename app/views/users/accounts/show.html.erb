<h2>Account</h2>

<article>
  <header><h3>Profile</h3></header>

  <%= form_with model: @user, url: account_path, method: :patch, scope: :user do |form| %>
    <%= form.label :name %>
    <%= form.text_field :name, required: true, autocomplete: "name", minlength: 3, maxlength: 72 %>

    <%= form.label :email %>
    <%= form.email_field :email, required: true, autocomplete: "email" %>

    <%= form.label :password_challenge, "Current password", for: "profile_password_challenge" %>
    <%= form.password_field :password_challenge, id: "profile_password_challenge", autocomplete: "current-password",
          aria: { describedby: "profile_password_challenge_hint" } %>
    <small id="profile_password_challenge_hint">Only needed to change your email.</small>

    <%= form.submit "Save profile" %>
  <% end %>
</article>

<article>
  <header><h3>Password</h3></header>

  <%= form_with model: @user, url: account_password_path, method: :patch, scope: :user do |form| %>
    <%= form.label :password_challenge, "Current password", for: "password_password_challenge" %>
    <%= form.password_field :password_challenge, id: "password_password_challenge", required: true, autocomplete: "current-password" %>

    <%= form.label :password, "New password" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72 %>

    <%= form.label :password_confirmation, "Repeat new password" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72,
          aria: { describedby: "password_hint" } %>
    <small id="password_hint">Changing your password signs you out on all other devices.</small>

    <%= form.submit "Change password" %>
  <% end %>
</article>

<article id="sessions">
  <header><h3>Sessions</h3></header>

  <table>
    <thead>
      <tr>
        <th>Device</th>
        <th>IP address</th>
        <th>Signed in</th>
      </tr>
    </thead>
    <tbody>
      <% @sessions.each do |device_session| %>
        <tr>
          <td>
            <%= device_session.user_agent.presence || "unknown" %>
            <% if device_session == Current.session %><mark>this device</mark><% end %>
          </td>
          <td><%= device_session.ip_address %></td>
          <td><%= l(device_session.created_at, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <footer class="grid">
    <%= button_to "Sign out", session_path, method: :delete %>
    <% if @sessions.size > 1 %>
      <%= button_to "Sign out of all other sessions", account_other_sessions_path, method: :delete, class: "secondary" %>
    <% end %>
  </footer>
</article>
