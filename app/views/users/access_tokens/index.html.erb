<h2>Access tokens</h2>

<p>
  For AI clients like Claude Code, through done's MCP server. A token reaches only your own entries,
  in the orgs and projects you pick, and only as long as you take part in them.
</p>

<article id="access-tokens">
  <% if personal_token_auth_connections.any? %>
    <table>
      <thead>
        <tr><th>Name</th><th>Access</th><th>Expires</th><th>Last used</th><th></th></tr>
      </thead>
      <tbody>
        <% personal_token_auth_connections.each do |token_auth_connection| %>
          <% token = token_auth_connection.access_tokens.max_by(&:created_at) %>
          <tr id="<%= dom_id(token_auth_connection) %>">
            <td><%= token_auth_connection.name %></td>
            <td><%= render "token_auth/connections/grants", token_auth_connection: %></td>
            <td><%= token.expired? ? "expired" : l(token.expires_at, format: :short) %></td>
            <td><%= token_auth_connection.last_used_at ? l(token_auth_connection.last_used_at, format: :short) : "never" %></td>
            <td><%= button_to "Revoke", user_access_token_path(token_auth_connection), method: :delete, class: "secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No access tokens yet.</p>
  <% end %>

  <footer class="grid">
    <%= link_to "Back", edit_user_path %>
    <% if current_user.token_auth_connections.active.exists? %>
      <%= button_to "Revoke all", destroy_all_user_access_tokens_path, method: :delete,
            form: { data: { turbo_confirm: "Revoke all access tokens and connected apps?" } } %>
    <% end %>
  </footer>
</article>

<article>
  <header><h3>New access token</h3></header>

  <%# a full page load: the secret is shown on the response instead of a redirect %>
  <%= form_with model: @token_auth_connection, url: user_access_tokens_path, id: "new-access-token", data: { turbo: false } do |form| %>
    <% if @token_auth_connection.errors.any? %>
      <p role="alert"><%= @token_auth_connection.errors.full_messages.to_sentence %></p>
    <% end %>

    <%= form.label :name, "Name, e.g. where you use it" %>
    <%= form.text_field :name, required: true, maxlength: 72, placeholder: "Claude Code laptop" %>

    <%= label_tag :expires_in_days, "Expires in" %>
    <%= select_tag :expires_in_days,
          options_for_select(TokenAuth::Connection::PERSONAL_EXPIRY_DAYS.map { [ pluralize(it, "day"), it ] }, @expires_in_days || 90) %>

    <%= render "token_auth/connections/grants_fields", memberships: grantable_memberships, chosen: params[:grants] %>

    <%= form.submit "Create token" %>
  <% end %>
</article>
