<h2>Sessions</h2>

<article id="sessions">
  <table>
    <thead>
      <tr>
        <th>Device</th>
        <th>IP address</th>
        <th>Signed in</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @sessions.each do |device_session| %>
        <tr>
          <td>
            <%= device_session.user_agent.presence || "unknown" %>
            <% if device_session == Current.session %><mark>this device</mark><% end %>
          </td>
          <td><%= device_session.ip_address %></td>
          <td><%= l(device_session.created_at, format: :short) %></td>
          <td><%= button_to "Sign out", user_session_path(device_session), method: :delete, class: "secondary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <footer class="grid">
    <%= link_to "Back", edit_user_path %>
    <% if @sessions.size > 1 %>
      <%= button_to "Sign out of all other sessions", destroy_others_user_sessions_path, method: :delete %>
    <% end %>
  </footer>
</article>
