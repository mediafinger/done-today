<nav>
  <div class="nav-grid">

    <div class="left">
      <h2>Done today</h2>
    </div>

    <div class="center zup">
      <% if current_user && current_project %>
        <%= render partial: "shared_partials/date_nav" %>
      <% end %>
    </div>

    <div class="left">
      <% if current_user && current_user.memberships.active.any? %>
        <%= render partial: "shared_partials/org_switcher" %>
      <% end %>
    </div>

    <div class="right zup">
      <%= link_to "?", help_path, role: "button", class: "slim", title: "Help", aria: { label: "Help" } %>
