<!DOCTYPE html>
<% if (theme = current_user&.theme) %>
  <html data-theme="<%= theme %>">
<% else %>
  <html>
<% end %>

  <%= render partial: "layouts/head" %>

  <body>

    <%= render partial: "layouts/header" %>

    <main>
      <%= yield %>
    </main>

    <%= render partial: "layouts/footer" %>

  </body>
</html>
